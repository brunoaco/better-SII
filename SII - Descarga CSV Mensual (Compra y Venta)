// ==UserScript==
// @name         SII - Descarga CSV Mensual (Compra y Venta)
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Itera los 12 meses del año seleccionado y descarga los CSV de Compra y Venta para un RUT fijo
// @author       Bruno
// @match        https://www4.sii.cl/consdcvinternetui/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(async () => {
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  // ============================================================
  // CONFIGURACIÓN
  // ============================================================
  // El RUT y el Año NO se fuerzan: el script usa lo que ya esté
  // seleccionado manualmente en los dropdowns al momento de iniciar.

  const MESES = [
    { valor: '01', nombre: 'Enero' },
    { valor: '02', nombre: 'Febrero' },
    { valor: '03', nombre: 'Marzo' },
    { valor: '04', nombre: 'Abril' },
    { valor: '05', nombre: 'Mayo' },
    { valor: '06', nombre: 'Junio' },
    { valor: '07', nombre: 'Julio' },
    { valor: '08', nombre: 'Agosto' },
    { valor: '09', nombre: 'Septiembre' },
    { valor: '10', nombre: 'Octubre' },
    { valor: '11', nombre: 'Noviembre' },
    { valor: '12', nombre: 'Diciembre' },
  ];

  // ============================================================
  // HELPERS GENERALES
  // ============================================================
  const waitFor = (condFn, timeout = 15000, interval = 400) => {
    return new Promise((resolve, reject) => {
      const start = Date.now();
      const check = () => {
        let ok = false;
        try { ok = condFn(); } catch (e) {}
        if (ok) return resolve(true);
        if (Date.now() - start > timeout) return reject('Timeout');
        setTimeout(check, interval);
      };
      check();
    });
  };

  const getScope = (el) => el ? angular.element(el).scope() : null;

  const buscarBotonPorTexto = (texto) =>
    [...document.querySelectorAll('button')].find(b => b.textContent.trim() === texto);

  const buscarLinkPorTexto = (texto) =>
    [...document.querySelectorAll('a')].find(a => a.textContent.trim().toUpperCase() === texto.toUpperCase());

  // ============================================================
  // ESPERAR A QUE ANGULAR Y EL FORMULARIO ESTÉN LISTOS
  // ============================================================
  await waitFor(() => {
    const sel = document.querySelector('select[name="rut"]');
    return sel && sel.options.length > 1;
  }, 20000);
  await sleep(800);

  // --- AVISO FLOTANTE: esperando que el usuario elija RUT/Año y presione Consultar ---
  const avisoId = 'sii-csv-aviso-espera';
  document.getElementById(avisoId)?.remove();
  const aviso = document.createElement('div');
  aviso.id = avisoId;
  aviso.style.cssText = `
    position:fixed; top:20px; right:20px; z-index:99998;
    background:#1e1e2e; color:#f9e2af; font-family:monospace; font-size:12px;
    border-radius:8px; padding:10px 14px; border:1px solid #313244;
    box-shadow:0 4px 20px rgba(0,0,0,0.5); max-width:280px;
  `;
  aviso.innerHTML = `⏳ Elige <strong>RUT</strong> y <strong>Año</strong>, y presiona <strong>Consultar</strong> para activar la descarga automática.`;
  document.body.appendChild(aviso);

  // Espera a que el usuario haga clic en "Consultar" con RUT y Año ya elegidos
  const esperarPrimeraConsulta = () => new Promise((resolve) => {
    const btn = document.querySelector('button[type="submit"]');
    const handler = () => {
      const rutSel = document.querySelector('select[name="rut"]');
      const anhoSel = [...document.querySelectorAll('select')].find(s =>
        [...s.options].some(o => /^\d{4}$/.test(o.value))
      );
      const rut = rutSel && rutSel.value ? rutSel.value : null;
      const anho = anhoSel && anhoSel.value ? anhoSel.value : null;
      if (rut && anho) {
        btn.removeEventListener('click', handler);
        resolve({ rut, anho });
      }
      // si falta algo, Angular bloqueará el submit por 'required' y el listener queda esperando el próximo clic
    };
    btn.addEventListener('click', handler);
  });

  const { rut: rutDetectado, anho: anhoDetectado } = await esperarPrimeraConsulta();
  document.getElementById(avisoId)?.remove();
  await sleep(1200); // dejar que la consulta manual del usuario cargue en pantalla

  // --- MODAL DE CONFIRMACIÓN INICIAL ---
  const esperarConfirmacion = (rutActual, anhoActual) => new Promise((resolve) => {
    const modalId = 'sii-csv-confirm-modal';
    document.getElementById(modalId)?.remove();

    const faltaSeleccion = false;

    const overlay = document.createElement('div');
    overlay.id = modalId;
    overlay.style.cssText = `
      position:fixed; inset:0; z-index:999999;
      background:rgba(0,0,0,0.6);
      display:flex; align-items:center; justify-content:center;
    `;
    overlay.innerHTML = `
      <div style="
        background:#1e1e2e; color:#cdd6f4;
        font-family:monospace; font-size:13px;
        border-radius:12px; padding:28px 32px;
        box-shadow:0 8px 32px rgba(0,0,0,0.6);
        border:1px solid #313244;
        max-width:440px; width:90%; text-align:center;
      ">
        <div style="font-size:32px; margin-bottom:12px;">📥</div>
        <div style="font-size:15px; font-weight:bold; color:#cba6f7; margin-bottom:10px;">
          Descarga CSV Mensual — Compra y Venta
        </div>
        <div style="background:#313244; border-radius:8px; padding:10px; margin:12px 0; color:#a6e3a1; font-size:14px;">
          🏢 RUT: <strong>${rutActual || '⚠️ no seleccionado'}</strong><br>
          📅 Año: <strong>${anhoActual || '⚠️ no seleccionado'}</strong>
        </div>
        <div style="color:#bac2de; margin-bottom:10px; text-align:left; font-size:12px;">
          Se recorrerán los 12 meses del año ya seleccionado, para el RUT ya
          seleccionado, y para cada uno se intentará descargar el CSV de
          <strong>Compra</strong> y de <strong>Venta</strong>.
        </div>
        <div style="background:#45475a; border-radius:8px; padding:8px; margin:8px 0; color:#f9e2af; font-size:11px; text-align:left;">
          ⚠️ Si un mes supera el límite de documentos para descarga directa,
          se <strong>saltará automáticamente</strong> (queda en cola diferida en el SII)
          y se marcará en el resumen final para que lo revises manualmente.
        </div>
        ${faltaSeleccion ? `
        <div style="background:#45475a; border:1px solid #f38ba8; border-radius:8px; padding:8px; margin:8px 0; color:#f38ba8; font-size:11px; text-align:left;">
          ❌ Falta seleccionar ${!rutActual ? 'RUT' : ''}${!rutActual && !anhoActual ? ' y ' : ''}${!anhoActual ? 'Año' : ''} en el formulario.
          Cierra este cuadro, selecciónalo(s) y vuelve a correr el script.
        </div>` : ''}
        <div style="color:#6c7086; font-size:11px; margin-bottom:20px;">
          No cierres ni recargues la página mientras corre.
        </div>
        <div style="display:flex; gap:12px; justify-content:center;">
          <button id="sii-csv-cancelar" style="
            background:#313244; color:#f38ba8;
            border:1px solid #f38ba8; padding:9px 24px;
            border-radius:8px; cursor:pointer; font-family:monospace; font-size:13px;
          ">✕ Cancelar</button>
          <button id="sii-csv-confirmar" ${faltaSeleccion ? 'disabled' : ''} style="
            background:${faltaSeleccion ? '#45475a' : '#a6e3a1'}; color:${faltaSeleccion ? '#6c7086' : '#1e1e2e'};
            border:none; padding:9px 24px; border-radius:8px;
            cursor:${faltaSeleccion ? 'not-allowed' : 'pointer'}; font-family:monospace; font-size:13px; font-weight:bold;
          ">▶ Iniciar</button>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);
    document.getElementById('sii-csv-confirmar').onclick = () => {
      if (faltaSeleccion) return;
      overlay.remove();
      resolve({ rut: rutActual, anho: anhoActual });
    };
    document.getElementById('sii-csv-cancelar').onclick = () => { overlay.remove(); resolve(null); };
  });

  const confirmacion = await esperarConfirmacion(rutDetectado, anhoDetectado);
  if (!confirmacion) return;
  const RUT_SELECCIONADO = confirmacion.rut;

  // --- PANEL VISUAL ---
  const panelId = 'sii-csv-progress-panel';
  document.getElementById(panelId)?.remove();
  const panel = document.createElement('div');
  panel.id = panelId;
  panel.style.cssText = `
    position:fixed; top:20px; right:20px; z-index:99999;
    width:400px; max-height:85vh; overflow-y:auto;
    background:#1e1e2e; color:#cdd6f4;
    font-family:monospace; font-size:12px;
    border-radius:10px; box-shadow:0 4px 20px rgba(0,0,0,0.5);
    border:1px solid #313244;
  `;
  panel.innerHTML = `
    <div style="background:#313244; padding:10px 14px; border-radius:10px 10px 0 0;
                display:flex; justify-content:space-between; align-items:center;
                position:sticky; top:0; z-index:1;">
      <span style="font-weight:bold; color:#cba6f7;">📥 SII — Descarga CSV Mensual</span>
      <button onclick="document.getElementById('${panelId}').remove()"
        style="background:none;border:none;color:#f38ba8;cursor:pointer;font-size:16px;">✕</button>
    </div>
    <div style="padding:10px 14px;">
      <div style="margin-bottom:8px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
          <span id="sii-csv-progress-label">Iniciando...</span>
          <span id="sii-csv-progress-pct" style="color:#a6e3a1;">0%</span>
        </div>
        <div style="background:#45475a; border-radius:4px; height:8px; overflow:hidden;">
          <div id="sii-csv-progress-bar" style="height:100%;width:0%;background:#a6e3a1;transition:width 0.3s;"></div>
        </div>
      </div>
      <div id="sii-csv-current" style="color:#89b4fa; margin-bottom:8px; min-height:16px;"></div>
      <div id="sii-csv-log" style="max-height:340px;overflow-y:auto;border-top:1px solid #313244;padding-top:8px;"></div>
      <div id="sii-csv-resumen" style="display:none; border-top:2px solid #cba6f7; margin-top:8px; padding-top:8px;"></div>
    </div>
  `;
  document.body.appendChild(panel);

  const setProgress = (current, total) => {
    const pct = Math.round((current / total) * 100);
    document.getElementById('sii-csv-progress-bar').style.width = pct + '%';
    document.getElementById('sii-csv-progress-pct').textContent = pct + '%';
    document.getElementById('sii-csv-progress-label').textContent = `Mes ${current} de ${total}`;
  };
  const setCurrent = txt => document.getElementById('sii-csv-current').textContent = txt;
  const addLog = (txt, color = '#a6e3a1') => {
    const log = document.getElementById('sii-csv-log');
    const el = document.createElement('div');
    el.style.cssText = `padding:3px 0; border-bottom:1px solid #313244; color:${color}; white-space:pre-wrap;`;
    el.textContent = txt;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
  };

  // ============================================================
  // HELPERS DE NAVEGACIÓN
  // ============================================================

  const setearRut = async () => {
    const sel = document.querySelector('select[name="rut"]');
    const scope = getScope(sel);
    scope.$apply(() => { scope.rut = RUT_SELECCIONADO; });
    sel.value = RUT_SELECCIONADO;
    await sleep(200);
  };

  const setearMes = async (valorMes) => {
    const sel = document.querySelector('#periodoMes');
    const scope = getScope(sel);
    scope.$apply(() => { scope.periodoMes = valorMes; });
    sel.value = valorMes;
    await sleep(200);
  };

  const clickConsultar = async () => {
    const btn = document.querySelector('button[type="submit"]');
    btn.click();
    await sleep(1200);
  };

  // Espera a que aparezca el botón "Descargar Detalles" o algún indicio de que no hay datos
  const esperarResultadoTab = async () => {
    try {
      await waitFor(() => {
        const btn = buscarBotonPorTexto('Descargar Detalles');
        return !!btn;
      }, 10000);
      return 'data';
    } catch (e) {
      return 'nodata';
    }
  };

  const clickTabCompra = async () => {
    const tab = document.querySelector('#tabCompra');
    if (tab) { tab.click(); await sleep(700); }
  };

  const clickTabVenta = async () => {
    const tab = buscarLinkPorTexto('VENTA');
    if (tab) { tab.click(); await sleep(700); }
  };

  // Procesa la descarga del CSV para la pestaña actualmente visible (compra o venta)
  const procesarDescarga = async (etiqueta) => {
    const estado = await esperarResultadoTab();

    if (estado === 'nodata') {
      addLog(`   ℹ️ ${etiqueta}: sin datos / sin movimientos`, '#6c7086');
      return { estado: 'sin_datos' };
    }

    const btn = buscarBotonPorTexto('Descargar Detalles');
    if (!btn) {
      addLog(`   ⚠️ ${etiqueta}: no se encontró el botón de descarga`, '#f9e2af');
      return { estado: 'error' };
    }

    const scope = getScope(btn);
    const totDocRes = scope ? scope.totDocRes : undefined;
    const limiteDoc = scope ? scope.limiteDoc : undefined;

    if (typeof totDocRes === 'number' && typeof limiteDoc === 'number' && totDocRes > limiteDoc) {
      addLog(`   ⏳ ${etiqueta}: ${totDocRes} docs supera el límite (${limiteDoc}) → cola diferida, se salta`, '#f9e2af');
      return { estado: 'diferido', totDocRes, limiteDoc };
    }

    addLog(`   ⬇️ ${etiqueta}: descargando (${totDocRes ?? '?'} docs)...`, '#a6e3a1');
    btn.click();
    await sleep(3000); // dar tiempo a que el navegador inicie la descarga
    return { estado: 'descargado', totDocRes };
  };

  // ============================================================
  // LÓGICA PRINCIPAL
  // ============================================================
  await setearRut();

  const resultados = [];

  for (let i = 0; i < MESES.length; i++) {
    const { valor, nombre } = MESES[i];
    setCurrent(`⏳ Procesando: ${nombre}`);
    setProgress(i + 1, MESES.length);
    addLog(`\n🔄 [${i + 1}/${MESES.length}] ${nombre}`, '#cba6f7');

    await setearRut();
    await setearMes(valor);
    await clickConsultar();

    // Esperar a que cargue algo (tabla, mensaje de no datos, o timeout general)
    await sleep(1000);

    await clickTabCompra();
    const resCompra = await procesarDescarga('COMPRA');

    await clickTabVenta();
    const resVenta = await procesarDescarga('VENTA');

    resultados.push({ mes: nombre, valor, compra: resCompra, venta: resVenta });
    await sleep(500);
  }

  // ============================================================
  // RESUMEN FINAL
  // ============================================================
  setCurrent('✔ Proceso completado');

  const resumenEl = document.getElementById('sii-csv-resumen');
  resumenEl.style.display = 'block';
  const addResumen = (txt, color = '#a6e3a1') => {
    const el = document.createElement('div');
    el.style.cssText = `padding:3px 0; border-bottom:1px solid #313244; color:${color}; white-space:pre-wrap;`;
    el.textContent = txt;
    resumenEl.appendChild(el);
  };

  addResumen('========== RESUMEN FINAL ==========', '#cba6f7');

  const descargados = resultados.filter(r => r.compra.estado === 'descargado' || r.venta.estado === 'descargado').length;
  const diferidos = resultados.filter(r => r.compra.estado === 'diferido' || r.venta.estado === 'diferido');
  const errores = resultados.filter(r => r.compra.estado === 'error' || r.venta.estado === 'error');

  addResumen(`✅ Meses con al menos una descarga: ${descargados}`, '#a6e3a1');

  if (diferidos.length === 0) {
    addResumen('🎉 Ningún mes quedó en cola diferida', '#a6e3a1');
  } else {
    addResumen(`⏳ Meses con CSV en cola diferida (requieren descarga manual):`, '#f9e2af');
    diferidos.forEach(r => {
      if (r.compra.estado === 'diferido') addResumen(`   📂 ${r.mes} — COMPRA (${r.compra.totDocRes} docs)`, '#f9e2af');
      if (r.venta.estado === 'diferido') addResumen(`   📂 ${r.mes} — VENTA (${r.venta.totDocRes} docs)`, '#f9e2af');
    });
  }

  if (errores.length > 0) {
    addResumen(`❌ Meses con error (revisar manualmente):`, '#f38ba8');
    errores.forEach(r => {
      if (r.compra.estado === 'error') addResumen(`   ${r.mes} — COMPRA`, '#f38ba8');
      if (r.venta.estado === 'error') addResumen(`   ${r.mes} — VENTA`, '#f38ba8');
    });
  }

  resumenEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  console.log('\n📋 JSON:', JSON.stringify(resultados, null, 2));

})();
